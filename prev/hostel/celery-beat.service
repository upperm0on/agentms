[Unit]
Description=Celery Beat Scheduler for Hostel Application
After=network.target redis.service postgresql.service
PartOf=staypal.service

[Service]
Type=forking
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/hostel
Environment="DJANGO_SETTINGS_MODULE=hostel.settings.prod"
Environment="PATH=/home/ubuntu/hostel/venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/ubuntu/hostel/venv/bin/celery -A hostel beat --loglevel=info --logfile=/home/ubuntu/hostel/logs/celery_beat.log --pidfile=/home/ubuntu/hostel/celery_beat.pid --detach
ExecStop=/bin/kill -s TERM $MAINPID
Restart=always
RestartSec=10
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true

# Create logs directory on startup
ExecStartPre=/bin/mkdir -p /home/ubuntu/hostel/logs
ExecStartPre=/bin/chown ubuntu:ubuntu /home/ubuntu/hostel/logs

[Install]
WantedBy=multi-user.target

